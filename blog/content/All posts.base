filters:
  and:
    - file.ext == "md"
    - file.name != "index"
    - not:
        - file.inFolder("templates")
properties:
  title:
    displayName: Title
  date:
    displayName: Date
views:
  - type: list
    name: All posts
    order:
      - title
      - date
    sort:
      - property: date
        direction: DESC
